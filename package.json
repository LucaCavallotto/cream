{
  "name": "personal-expense-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:browser && npm run test:dev",
    "test:unit": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:browser": "playwright test",
    "test:report": "playwright show-report",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pretest:browser": "npm run test:build",
    "test:build": "npm run build && node --test tests/build/*.test.mjs",
    "test:dev": "playwright test --config=playwright.dev.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "chart.js": "4.4.2",
    "papaparse": "5.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
